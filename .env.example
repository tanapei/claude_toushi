# =============================================
# Claude 自動トレーダー — 環境変数設定例
# このファイルを .env にコピーして値を設定してください。
# cp .env.example .env
# =============================================

# Anthropic API キー（Claude AI による改善分析に使用）
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# kabuステーション® API パスワード（kabuステーション® の設定 → API で確認）
KABU_API_PASSWORD=your_kabu_api_password_here

# kabuステーション® 取引パスワード（口座の取引パスワード）
KABU_TRADE_PASSWORD=your_trade_password_here

# LINE Messaging API（通知機能。未設定の場合は通知をスキップ）
# チャンネルアクセストークン: LINE Developers Console → Messaging API設定 → チャンネルアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
# あなたのユーザーID: LINE Developers Console → チャンネル基本設定 → あなたのユーザーID
LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# データ保存先ディレクトリ（省略時はプロジェクト内 data/ を使用）
# STORAGE_DIR=/path/to/storage
